# Copy to .env and edit. See docs/DEPLOY.md.
BOBA_PUBLIC_URL=https://boba.example.com
# 0.0.0.0 to expose the port directly (plain HTTP, testing only); 127.0.0.1 behind a proxy.
BOBA_BIND=127.0.0.1
# Run the container as your user so mounted files keep the right owner (id -u / id -g).
BOBA_UID=1000
BOBA_GID=1000
BOBA_REPOS_DIR=/srv/repos

# --- Claude Code credentials: pick ONE
# a) Organisation API key (shared runners, anyone's work):
# ANTHROPIC_API_KEY=sk-ant-...
# b) Your own Claude subscription (only YOUR runs are real; others are simulated):
# BOBA_CLAUDE_AUTH=subscription
# BOBA_LOCAL_RUNNER_OWNER=you@example.com
# CLAUDE_HOME=/home/you
# None of the above = demo mode (agents are simulated).

# GitHub access for PRs and repo sync
# GH_TOKEN=ghp_...
